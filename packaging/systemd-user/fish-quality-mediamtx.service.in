[Unit]
Description=Fish Quality MediaMTX
PartOf=fish-quality.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/mediamtx
ExecStart=@PROJECT_ROOT@/mediamtx/mediamtx @PROJECT_ROOT@/mediamtx/mediamtx.yml
Restart=always
RestartSec=3

[Install]
WantedBy=fish-quality.target
