[Unit]
Description=Fish Quality User-Space Process Watchdog
PartOf=fish-quality.target
After=fish-quality-backend.service fish-quality-worker.service fish-quality-mediamtx.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-%h/.config/fish-quality/source.env
Environment=PATH=@CONDA_ENV_DIR@/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash @PROJECT_ROOT@/scripts/process_watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=fish-quality.target
