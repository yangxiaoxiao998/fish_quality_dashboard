[Unit]
Description=Fish Quality FastAPI Backend
PartOf=fish-quality.target
After=network-online.target fish-quality-mediamtx.service fish-quality-worker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/backend
EnvironmentFile=-%h/.config/fish-quality/source.env
Environment=FISH_RQ_QUEUE=fish
Environment=PYTHONNOUSERSITE=1
Environment=PATH=@CONDA_ENV_DIR@/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@CONDA_ENV_DIR@/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=fish-quality.target
