DATABASE_URL=postgresql://fish:fish@127.0.0.1:5432/fishdb
REDIS_URL=redis://127.0.0.1:6379/0
# Queue used by the packaged API and Worker. Keep this different from the
# source-mode queue when both installations share the same Redis instance.
FISH_RQ_QUEUE=fish-quality-packaged
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UPGRADE_MANAGER_HOST=127.0.0.1
UPGRADE_MANAGER_PORT=8012
FISH_PI_BASE_URL=http://raspberrypi.local:9000
FISH_CAMERA_AUTO_PUSH_URL=1
FISH_CAMERA_NETWORK_INTERFACE=enp3s0
FISH_CAMERA_READ_URL=rtmp://127.0.0.1:1935/fish_camera
# FISH_DATA_ROOT=/path/to/writable/data
# FISH_ALGO_ROOT=/path/to/algorithms
# ALGORITHM_PYTHON=/path/to/external/python
